# ---- Required -------------------------------------------------------------
DISCORD_TOKEN=your-bot-token-here

# ---- Optional -------------------------------------------------------------
# Comma-separated Discord user IDs with full bot access in every server
# (the server owner always has access). Leave empty for none.
OWNER_IDS=

# Set to a server ID to sync slash commands instantly to that server (testing).
# Leave empty for global commands.
DEV_GUILD_ID=

# Storage
DATA_DIR=./data
DB_PATH=./data/xzy_security.db

# Needs the privileged "Message Content Intent" enabled in the Developer Portal.
# Required for message backup and the "!" unauthorised-command guard.
ENABLE_MESSAGE_CONTENT=true
ENABLE_MESSAGE_BACKUP=true
MESSAGE_BACKUP_LIMIT=100        # messages kept per channel
MESSAGE_RETENTION_DAYS=7
MESSAGE_RESTORE_LIMIT=50        # messages replayed into a restored channel
RESTORE_LOOKBACK_HOURS=24       # window for /autorestore restore_now

# Prefix used by the unauthorised-command guard (/addunauth)
UNAUTH_PREFIX=!

LOG_LEVEL=INFO

